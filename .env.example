# ─────────────────────────────────────────────────────────────
# Formulaire de contact — configuration SMTP
# Copiez ce fichier en `.env.local` (en local) ou renseignez ces
# variables dans Vercel → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Nom du serveur SMTP de votre fournisseur d'email.
#   Namecheap Private Email : mail.privateemail.com
#   Google Workspace / Gmail : smtp.gmail.com
SMTP_HOST=mail.privateemail.com

# Port SMTP : 465 (SSL) ou 587 (STARTTLS).
#   Namecheap Private Email : 465
#   Gmail : 465
SMTP_PORT=465

# Votre adresse email complète (expéditeur ET destinataire par défaut).
#   Exemple : info@eco-sturct.com
SMTP_USER=info@eco-sturct.com

# Le mot de passe SMTP (ou « App Password » pour Gmail).
SMTP_PASS=your-smtp-password

# (Optionnel) Adresse de réception, si différente de SMTP_USER.
#   Si non renseignée, le message est envoyé à SMTP_USER.
CONTACT_TO_EMAIL=info@eco-sturct.com
