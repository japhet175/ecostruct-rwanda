# ─────────────────────────────────────────────────────────────
# Formulaire de contact — Web3Forms
# Le formulaire envoie directement vers Web3Forms, qui transmet
# l'email dans la boîte configurée sur https://web3forms.com.
# Définissez cette variable dans Vercel → Settings → Environment
# Variables (ou dans un `.env.local` pour le développement).
# ─────────────────────────────────────────────────────────────

# Clé d'accès Web3Forms (reçue par email après inscription).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=votre-cle-web3forms
